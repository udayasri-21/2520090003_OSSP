#include <stdio.h>
#include <string.h>

int main() {
    char single_quote[] = "'Hello World'";
    char double_quote[] = "\"Hello World\"";

    printf("Single quoted string: %s\n", single_quote);
    printf("Double quoted string: %s\n", double_quote);

    printf("\nTesting spaces:\n");
    printf("Single quotes preserve: %s\n", single_quote);
    printf("Double quotes preserve: %s\n", double_quote);

    printf("\nTesting literal content:\n");
    printf("Single quotes: '$name'\n");
    printf("Double quotes: \"$name\"\n");

    return 0;
}
