#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>

int global_var = 100;
int uninitialized_global;

static int static_global = 200;

void show_code_address(void)
{
    printf("Code address             : %p\n",
           (void *)show_code_address);
}

int main(void)
{
    int local_var = 10;
    static int static_local = 300;

    int *heap_var = malloc(sizeof(int));

    if (heap_var == NULL) {
        perror("malloc failed");
        return 1;
    }

    *heap_var = 400;

    printf("Process ID (PID)         : %d\n", getpid());

    show_code_address();

    printf("Global variable address  : %p\n",
           (void *)&global_var);

    printf("Uninitialized global     : %p\n",
           (void *)&uninitialized_global);

    printf("Static global address    : %p\n",
           (void *)&static_global);

    printf("Static local address     : %p\n",
           (void *)&static_local);

    printf("Heap variable address    : %p\n",
           (void *)heap_var);

    printf("Stack variable address   : %p\n",
           (void *)&local_var);

    printf("\nPress Enter to exit...\n");
    getchar();

    free(heap_var);

    return 0;
}
