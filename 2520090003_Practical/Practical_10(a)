#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/mman.h>
#include <string.h>

int main()
{
    int fd;
    char *ptr;

    // Open file
    fd = open("data.txt", O_RDWR | O_CREAT, 0644);

    if (fd < 0)
    {
        perror("File opening failed");
        return 1;
    }

    // Set file size
    ftruncate(fd, 100);

    // Map file into memory
    ptr = mmap(NULL, 100,
               PROT_READ | PROT_WRITE,
               MAP_SHARED, fd, 0);

    if (ptr == MAP_FAILED)
    {
        perror("mmap failed");
        close(fd);
        return 1;
    }

    // Write data
    strcpy(ptr, "Hello from mmap!");

    printf("Data written to file:\n");
    printf("%s\n", ptr);

    // Read data
    printf("\nData read from file:\n");
    printf("%s\n", ptr);

    // Unmap memory
    munmap(ptr, 100);

    // Close file
    close(fd);

    return 0;
}
