#include <stdio.h>      // printf()
#include <stdlib.h>     // exit()
#include <string.h>     // strlen(), memset()
#include <fcntl.h>      // open(), O_RDONLY, O_WRONLY
#include <unistd.h>     // read(), write(), close()
#include <sys/stat.h>   // mkfifo()

// FIFO for Client → Server communication
#define REQUEST_FIFO "client_to_server"

// FIFO for Server → Client communication
#define RESPONSE_FIFO "server_to_client"

int main()
{
    // Stores message received from client
    char message[100];

    // Stores response sent to client
    char response[200];

    // Create Client → Server FIFO
    mkfifo(REQUEST_FIFO, 0666);

    // Create Server → Client FIFO
    mkfifo(RESPONSE_FIFO, 0666);

    // Display server status
    printf("Server started...\n");
    printf("Waiting for client message...\n");

    // Open Client → Server FIFO for reading
    // O_RDONLY = Read Only
    int request_fd = open(REQUEST_FIFO, O_RDONLY);

    // Open Server → Client FIFO for writing
    // O_WRONLY = Write Only
    int response_fd = open(RESPONSE_FIFO, O_WRONLY);

    // Server continuously waits for messages
    while (1)
    {
        // Clear the message buffer
        // memset() sets memory to 0
        memset(message, 0, sizeof(message));

        // Read message from client
        int n = read(request_fd, message, sizeof(message) - 1);

        // Check if message was received
        if (n > 0)
        {
            // Add end of string
            message[n] = '\0';

            // Display client's message
            printf("Client sent: %s\n", message);

            // Prepare response
            snprintf(response, sizeof(response),
                     "Server received your message: %s", message);

            // Send response to client
            // strlen() finds response length
            write(response_fd, response, strlen(response));

            printf("Response sent to client.\n");
        }
    }

    // Close FIFOs
    close(request_fd);
    close(response_fd);

    return 0;
}
