#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t child1, child2, child3;

    printf("Parent PID: %d\n", getpid());

    child1 = fork();

    if (child1 < 0)
    {
        printf("Fork failed!\n");
        return 1;
    }

    if (child1 == 0)
    {
        printf("Child 1: PID = %d\n", getpid());
        sleep(3);
        printf("Child 1 finished.\n");
        return 0;
    }

    child2 = fork();

    if (child2 < 0)
    {
        printf("Fork failed!\n");
        return 1;
    }

    if (child2 == 0)
    {
        printf("Child 2: PID = %d\n", getpid());
        sleep(1);
        printf("Child 2 finished.\n");
        return 0;
    }

    child3 = fork();

    if (child3 < 0)
    {
        printf("Fork failed!\n");
        return 1;
    }

    if (child3 == 0)
    {
        printf("Child 3: PID = %d\n", getpid());
        sleep(2);
        printf("Child 3 finished.\n");
        return 0;
    }

    printf("\nParent waiting for Child 1...\n");
    waitpid(child1, NULL, 0);
    printf("Child 1 collected.\n");

    printf("Parent waiting for Child 2...\n");
    waitpid(child2, NULL, 0);
    printf("Child 2 collected.\n");

    printf("Parent waiting for Child 3...\n");
    waitpid(child3, NULL, 0);
    printf("Child 3 collected.\n");

    printf("All children completed.\n");

    return 0;
}
