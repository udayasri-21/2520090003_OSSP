#include <stdio.h>
#include <stdlib.h>

int main() {
    int i;

    // malloc()
    int *a = (int *)malloc(3 * sizeof(int));

    if (a == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (i = 0; i < 3; i++) {
        a[i] = (i + 1) * 10;
    }

    printf("After malloc(): ");
    for (i = 0; i < 3; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");

    // calloc()
    int *b = (int *)calloc(3, sizeof(int));

    if (b == NULL) {
        printf("Memory allocation failed\n");
        free(a);
        return 1;
    }

    printf("After calloc(): ");
    for (i = 0; i < 3; i++) {
        printf("%d ", b[i]);
    }
    printf("\n");

    // realloc()
    a = (int *)realloc(a, 5 * sizeof(int));

    if (a == NULL) {
        printf("Reallocation failed\n");
        free(b);
        return 1;
    }

    a[3] = 40;
    a[4] = 50;

    printf("After realloc(): ");
    for (i = 0; i < 5; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");

    // free()
    free(a);
    free(b);

    printf("Memory freed successfully.\n");

    return 0;
}
