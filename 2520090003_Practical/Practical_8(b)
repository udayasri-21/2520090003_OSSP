#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    int *data = malloc(5 * sizeof(int));

    if (data == NULL) {
        printf("Memory allocation failed\n");
        return 1;
    }

    for (int i = 0; i < 5; i++) {
        data[i] = 10;
    }

    printf("Before fork():\n");
    printf("Parent data: ");

    for (int i = 0; i < 5; i++) {
        printf("%d ", data[i]);
    }
    printf("\n");

    pid_t pid = fork();

    if (pid < 0) {
        printf("Fork failed\n");
        free(data);
        return 1;
    }

    if (pid == 0) {
        // Child process
        printf("\nChild before modification:\n");
        printf("Child data: ");

        for (int i = 0; i < 5; i++) {
            printf("%d ", data[i]);
        }
        printf("\n");

        // Modify data in child
        data[0] = 100;
        data[1] = 200;

        printf("Child after modification:\n");
        printf("Child data: ");

        for (int i = 0; i < 5; i++) {
            printf("%d ", data[i]);
        }
        printf("\n");

        free(data);
        exit(0);
    }
    else {
        // Parent process
        wait(NULL);

        printf("\nParent after child modification:\n");
        printf("Parent data: ");

        for (int i = 0; i < 5; i++) {
            printf("%d ", data[i]);
        }
        printf("\n");

        free(data);
    }

    return 0;
}
