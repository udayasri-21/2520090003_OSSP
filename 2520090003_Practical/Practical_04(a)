#include <stdio.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    pid_t pid;
    int i;

    printf("Parent PID: %d\n", getpid());

    for (i = 1; i <= 3; i++)
    {
        pid = fork();

        if (pid < 0)
        {
            printf("Fork failed!\n");
            return 1;
        }

        if (pid == 0)
        {
            printf("Child %d: PID = %d, PPID = %d\n",
                   i, getpid(), getppid());

            sleep(i);

            printf("Child %d finished.\n", i);
            return 0;
        }
    }

    for (i = 1; i <= 3; i++)
    {
        wait(NULL);
        printf("Parent collected a child.\n");
    }

    printf("All children completed.\n");

    return 0;
}
